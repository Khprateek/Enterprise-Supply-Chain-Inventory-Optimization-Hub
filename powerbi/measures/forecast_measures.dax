/* ==============================================================================
   FORECAST PERFORMANCE MEASURES
   Display Folder: Forecast
   Source of truth: Synced from Power BI via Tabular Editor export — 2026-09-17
   ============================================================================== */

// ─────────────────────────────────────────────────────────────────────────────
// SECTION 1: FORECAST VOLUME
// ─────────────────────────────────────────────────────────────────────────────

/// Consensus forecasted demand units from FactDemandForecast
[Total Forecasted Quantity] =
SUM(FactDemandForecast[ForecastedQuantity])

/// Algorithmic baseline statistical projection (pre-planner-adjustment)
[Baseline Statistical Quantity] =
SUM(FactDemandForecast[BaselineStatisticalQuantity])

/// Total manual adjustments applied by planners over the baseline
[Planner Adjustment Quantity] =
SUM(FactDemandForecast[PlannerAdjustmentQuantity])

/// Total forecasted demand value (ForecastedQuantity * UnitListPrice)
[Total Forecast Value] =
SUM(FactDemandForecast[ForecastValue])

// ─────────────────────────────────────────────────────────────────────────────
// SECTION 2: FORECAST ACCURACY
// Grain: evaluated at Month × Product × Warehouse level via SUMMARIZE.
// This ensures ABS error is computed per-SKU-month, not at aggregate level
// (which would allow positive and negative errors to cancel each other out).
// ─────────────────────────────────────────────────────────────────────────────

/// Absolute Forecast Error = SUM(|Actual − Forecast|) at Month × Product × Warehouse grain
/// IMPLEMENTATION NOTE (PBI actual): Two versions exist. The version in the 'measure' table
/// uses COALESCE(..., 0) on both actual and forecast to handle nulls explicitly.
[Absolute Forecast Error Units] =
SUMX(
    SUMMARIZE(
        FactDemandForecast,
        DimDate[MonthYear],
        DimProduct[ProductKey],
        DimWarehouse[WarehouseKey]
    ),
    VAR ActualDemand   = [Total Ordered Quantity]
    VAR ForecastDemand = [Total Forecasted Quantity]
    RETURN
        ABS( COALESCE(ActualDemand, 0) - COALESCE(ForecastDemand, 0) )
)

/// WAPE (Weighted Absolute Percentage Error) = Total Absolute Error / Total Actual Demand
/// Industry standard for skewed-distribution products; preferred over MAPE for FMCG
[Forecast WAPE Pct] =
DIVIDE([Absolute Forecast Error Units], [Total Ordered Quantity], 0)

/// Forecast Accuracy = 1 − WAPE (clamped to 0% floor; cannot be negative)
/// IMPLEMENTATION NOTE (PBI actual): version in 'measure' table adds ISBLANK guard
[Forecast Accuracy Pct] =
VAR WAPE = [Forecast WAPE Pct]
RETURN
    IF(
        ISBLANK([Total Ordered Quantity]) || [Total Ordered Quantity] = 0,
        BLANK(),
        MAX(0, 1 - WAPE)
    )

/// Forecast Bias = (Forecast − Actual) / Actual
/// Positive = systemic over-forecast; Negative = systemic under-forecast
[Forecast Bias Pct] =
DIVIDE([Total Forecasted Quantity] - [Total Ordered Quantity], [Total Ordered Quantity], 0)
